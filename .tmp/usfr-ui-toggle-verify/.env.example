# Copy this file to .env on the Linux server.  Leave secret values blank here.
# The Compose service is self-contained: no local Skill path or external
# Python port factory is needed.
USFR_CAPABILITY_SECRET=
USFR_DEPLOYMENT_FACTORY=server.packaged_factory:build_runtime
USFR_PORT_FACTORY=server.packaged_ports:build_ports
USFR_PROFILE_MODE=shadow
USFR_API_PORT=8080
USFR_S3_BUCKET=usfr-media
USFR_ALLOWED_OSS_HOSTS=*.oss-cn-hangzhou.aliyuncs.com
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# Alibaba Cloud OSS. Source assets and final videos are permanent; MinIO is
# only the job-private temporary workspace.
USFR_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
USFR_OSS_BUCKET=
USFR_OSS_ACCESS_KEY_ID=
USFR_OSS_ACCESS_KEY_SECRET=
USFR_OSS_PUBLIC_BASE_URL=
USFR_OSS_FINAL_PREFIX=usfr

# Ephemeral job/object retention and bounded opaque-UI retiming.
USFR_JOB_TERMINAL_TTL_SECONDS=604800
# 0 = terminal success/failure schedules immediate deletion of MinIO working
# copies and intermediate evidence. Redis job/token metadata still keeps the
# independent USFR_JOB_TERMINAL_TTL_SECONDS lifetime.
USFR_TEMPORARY_RETENTION_SECONDS=0
USFR_UI_OPERATION_MIN_RATE=0.85
USFR_UI_OPERATION_MAX_RATE=1.20
# Automatic UI redraw for product/model/language-only replacement. Default off.
# Explicit ui_screenshots or an official app_store_url always enable the
# target-UI route; ui_operation_video always remains the opaque splice route.
USFR_UI_REBUILD_ENABLED=false

# GPT is the only semantic-reasoning provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODEL_CONFIG_SHA256=

# RunningHub owns media workflow execution.
RUNNINGHUB_API_KEY=
RUNNINGHUB_SEEDANCE_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_SEEDANCE_CREATE_URL=https://www.runninghub.ai/openapi/v2/bytedance/seedance-2.0-fast-token/multimodal-video
RUNNINGHUB_SEEDANCE_QUERY_URL=https://www.runninghub.ai/openapi/v2/query
RUNNINGHUB_SEEDANCE_UPLOAD_URL=https://www.runninghub.ai/openapi/v2/media/upload/binary
RUNNINGHUB_SEEDANCE_CONFIG_SHA256=
RUNNINGHUB_WHISPER_WORKFLOW_ID=
RUNNINGHUB_WHISPER_INPUT_NODE_ID=12
RUNNINGHUB_WHISPER_INPUT_FIELD=audio
SEEDANCE_API_PROVIDER=runninghub_standard

# Optional uploaded-audio song/non-song classifier. Leave all four values
# empty when audio uploads are disabled. The first three values are an atomic
# group: partial configuration makes service startup fail closed. Production
# profiles require an HTTPS endpoint.
USFR_UPLOADED_AUDIO_CLASSIFIER_ENDPOINT=
USFR_UPLOADED_AUDIO_CLASSIFIER_MODEL_ID=
USFR_UPLOADED_AUDIO_CLASSIFIER_MODEL_SHA256=
USFR_UPLOADED_AUDIO_CLASSIFIER_API_TOKEN=
