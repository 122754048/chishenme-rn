{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/high_fidelity_profile.schema.json",
  "title": "Internal high-fidelity hybrid profile snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "schema_version",
    "revision",
    "profile_sha256",
    "schema_sha256",
    "config_digest",
    "config_sha256",
    "activation_mode",
    "created_at",
    "dependencies",
    "parent_digests",
    "artifact",
    "snapshot_sha256"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "package_path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "package_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "content_type", "uri", "private", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "content_type": {"type": "string", "minLength": 1},
        "uri": {"type": ["string", "null"]},
        "private": {"const": true},
        "sha256": {"$ref": "#/$defs/sha256"},
        "tenant_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "producer_stage": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string", "minLength": 1}
      }
    },
    "activationReceipt": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "receipt_id",
        "artifact_id",
        "uri",
        "object_key",
        "sha256",
        "size_bytes",
        "content_type",
        "immutable",
        "server_minted",
        "receipt_sha256"
      ],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "object_key": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "content_type": {"const": "application/json"},
        "immutable": {"const": true},
        "server_minted": {"const": true},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "activationReportEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "report_sha256", "publication_receipt"],
      "properties": {
        "report": {"type": "object"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "publication_receipt": {"$ref": "#/$defs/activationReceipt"}
      }
    }
  },
  "properties": {
    "profile": {"const": "high_fidelity_hybrid_v1"},
    "schema_version": {"const": "high-fidelity-profile/v1"},
    "revision": {"const": 1},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "schema_sha256": {"$ref": "#/$defs/sha256"},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "activation_mode": {"type": "string", "minLength": 1},
    "activation_evidence": {
      "type": "object",
      "description": "Internal deployment evidence. Production/default activation requires the strict immutable report envelopes and server-recomputed aggregate; legacy Shadow callers may retain the historical summary shape.",
      "properties": {
        "schema_version": {"const": "high-fidelity-activation-evidence/v1"},
        "shadow": {"$ref": "#/$defs/activationReportEnvelope"},
        "matched_ab": {"$ref": "#/$defs/activationReportEnvelope"},
        "regression": {"$ref": "#/$defs/activationReportEnvelope"},
        "aggregate": {"type": "object"},
        "aggregate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "parent_digests": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "artifact": {"$ref": "#/$defs/artifact"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"}
  }
}
