{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/queue_message.schema.json",
  "title": "Ephemeral job work message",
  "type": "object",
  "required": ["job_id", "stage", "expected_version", "dedupe_key"],
  "additionalProperties": false,
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "expected_version": {"type": "integer"},
    "dedupe_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
