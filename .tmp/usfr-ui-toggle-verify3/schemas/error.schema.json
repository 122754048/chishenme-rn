{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/error.schema.json",
  "title": "Replication error envelope",
  "type": "object",
  "required": ["code", "category", "message", "retryable", "user_action_required", "occurred_at"],
  "additionalProperties": true,
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "message": {"type": "string"},
    "retryable": {"type": "boolean"},
    "user_action_required": {"type": "boolean"},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
