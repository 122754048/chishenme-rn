{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/stage_capabilities.schema.json",
  "title": "High-fidelity deployment stage capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "capabilities", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "stage-capabilities/v1"},
    "profile": {"const": "high_fidelity_hybrid_v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dynamics_analyzer",
        "asr_transcriber",
        "ocr_ui_renderer",
        "seedance20_compiler",
        "compositor",
        "qc_engine",
        "provider_adapter"
      ],
      "properties": {
        "dynamics_analyzer": {"$ref": "#/$defs/capability"},
        "asr_transcriber": {"$ref": "#/$defs/capability"},
        "ocr_ui_renderer": {"$ref": "#/$defs/capability"},
        "seedance20_compiler": {"$ref": "#/$defs/capability"},
        "compositor": {"$ref": "#/$defs/capability"},
        "qc_engine": {"$ref": "#/$defs/capability"},
        "provider_adapter": {"$ref": "#/$defs/capability"}
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "implementation", "version", "sha256"],
      "properties": {
        "declared": {"const": true},
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
