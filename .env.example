# USFR server configuration. Do not put real values in this file.
APP_NAME=usfr-backend
APP_ENV=production

# Provider credentials are server-only.
RUNNINGHUB_API_KEY=
YOUDAO_API_KEY=
YOUDAO_BASE_URL=https://openapi.youdao.com/llmgateway
YOUDAO_SEEDANCE_MODEL=seedance-2.0
YOUDAO_SEEDANCE_RESOLUTION=720p
YOUDAO_PROJECT_NAME=default
SEEDANCE_API_PROVIDER=youdao

# Standard USFR commercial batch deployment.
REPLICATION_RUNTIME_FACTORY=app.usfr_commercial_deployment:build_replication_runtime
USFR_DEPLOYMENT_FACTORY=app.usfr_commercial_deployment:build_deployment_runtime
USFR_DEPLOYMENT_BUNDLE_SKILL_SHA256=replace-with-packaged-skill-sha256
USFR_DEPLOYMENT_BUNDLE_TREE_SHA256=replace-with-packaged-tree-sha256
USFR_CAPABILITY_SECRET=replace-with-at-least-32-bytes
USFR_COMMERCIAL_BATCH_UPLOAD_SCOPE=replace-with-server-issued-upload-scope
USFR_COMMERCIAL_BATCH_TTL_SECONDS=3600
USFR_BATCH_CONCURRENCY_PROBE_DYNAMICS=2
USFR_BATCH_CONCURRENCY_ASR_LOCALIZATION=2
USFR_BATCH_CONCURRENCY_STORYBOARD_GENERATION=2
USFR_BATCH_CONCURRENCY_PROVIDER_POLL=4
USFR_BATCH_CONCURRENCY_ASSEMBLY_QC=2
USFR_BATCH_CAPACITY_LEASE_MS=3600000
USFR_WORKER_CAPABILITY=probe_dynamics

# Required only when commercial background-music execution is deployed.
# USFR_BACKGROUND_MUSIC_ADAPTER_FACTORY=production.usfr_music:build_adapter
