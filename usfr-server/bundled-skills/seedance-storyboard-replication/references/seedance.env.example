# Worker/container injects this private file with SEEDANCE_ENV_FILE or --env-file.
# Do not rely on a workstation ~/.codex/secrets path in production.
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=

SEEDANCE_API_PROVIDER=youdao
YOUDAO_API_KEY=
YOUDAO_BASE_URL=https://openapi.youdao.com/llmgateway
YOUDAO_SEEDANCE_MODEL=seedance-2.0-fast
YOUDAO_SEEDANCE_RESOLUTION=720p
YOUDAO_PROJECT_NAME=default
