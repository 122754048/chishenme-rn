{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/result_handle.schema.json",
  "title": "Stateless final result handle payload",
  "type": "object",
  "required": ["v", "object_key", "sha256", "size_bytes"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "object_key": {
      "type": "string",
      "pattern": "^final/(?!\\.{1,2}/)[^/%\\\\?#\\u0000-\\u001F\\u007F-\\u009F\\uD800-\\uDFFF]+/result\\.mp4$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
