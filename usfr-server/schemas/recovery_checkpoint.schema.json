{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usfr.local/schemas/recovery_checkpoint.schema.json",
  "title": "Adaptive Fidelity Recovery Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal_contract_sha256", "status", "iteration", "failure", "strategy", "candidate", "focused_qc", "next_action"],
  "properties": {
    "goal_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["REQUIRED", "PLANNING", "EXECUTING", "VERIFYING", "ACHIEVED", "EXTERNAL_BLOCKED"]},
    "iteration": {"type": "integer", "minimum": 0},
    "failure": {"type": ["object", "null"]},
    "strategy": {"type": ["object", "null"]},
    "candidate": {"type": ["object", "null"]},
    "focused_qc": {"type": ["object", "null"]},
    "next_action": {"type": ["string", "null"]}
  }
}
