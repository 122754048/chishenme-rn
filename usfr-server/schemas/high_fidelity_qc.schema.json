{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/high_fidelity_qc.schema.json",
  "title": "High-fidelity hybrid QC extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "dimensions",
    "total_score",
    "route_coverage",
    "ui_ocr",
    "hard_failures",
    "factor_scores",
    "accepted"
  ],
  "properties": {
    "schema_version": {"const": "high-fidelity-qc/v1"},
    "profile": {"const": "high_fidelity_hybrid_v1"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_route",
        "background_lighting",
        "composition_camera",
        "performance",
        "action_chain",
        "truth",
        "voiceover_audio",
        "overlays",
        "commercial",
        "continuity_technical"
      ],
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": ["score", "weight", "evidence"],
          "properties": {
            "score": {"type": "number", "minimum": 0, "maximum": 100},
            "weight": {"type": "number", "minimum": 0, "maximum": 100},
            "criticality": {"enum": ["H", "M", "L"]},
            "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
            "observations": {"type": "array"}
          },
          "additionalProperties": true
        }
      }
    },
    "total_score": {"type": "number", "minimum": 0, "maximum": 100},
    "route_coverage": {"type": "number", "minimum": 0, "maximum": 100},
    "ui_ocr": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 100},
        {"type": "null"}
      ]
    },
    "hard_failures": {"type": "array", "items": {"type": "string"}},
    "factor_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "evidence"],
        "properties": {
          "score": {"type": "number", "minimum": 0, "maximum": 100},
          "criticality": {"enum": ["H", "M", "L"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
        },
        "additionalProperties": true
      }
    },
    "media_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_output_sha256", "current_run_source_sha256s"],
      "properties": {
        "final_output_sha256": {"$ref": "#/$defs/sha256"},
        "current_run_source_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "evaluator_receipt": {"$ref": "#/$defs/evaluatorReceipt"},
    "accepted": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluatorReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provenance",
        "implementation",
        "version",
        "model_id",
        "model_sha256",
        "request_sha256",
        "response_sha256",
        "dimensions_sha256",
        "factor_scores_sha256",
        "final_output_sha256",
        "current_run_source_sha256s"
      ],
      "properties": {
        "schema_version": {"const": "high-fidelity-qc-evaluator-receipt/v1"},
        "provenance": {"const": "independent_evaluator"},
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "response_sha256": {"$ref": "#/$defs/sha256"},
        "dimensions_sha256": {"$ref": "#/$defs/sha256"},
        "factor_scores_sha256": {"$ref": "#/$defs/sha256"},
        "final_output_sha256": {"$ref": "#/$defs/sha256"},
        "current_run_source_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "anchor": {
      "type": "object",
      "properties": {
        "frame_id": {"type": ["string", "integer"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true,
      "anyOf": [
        {"required": ["frame_id"]},
        {"required": ["start_ms", "end_ms"]}
      ]
    },
    "reference": {
      "type": "object",
      "required": ["artifact_sha256", "pointer"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "pointer": {"type": "string", "minLength": 1},
        "frame_id": {"type": ["string", "integer"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true,
      "anyOf": [
        {"required": ["frame_id"]},
        {"required": ["start_ms", "end_ms"]}
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "kind", "method", "source_ref", "target_ref", "observation"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["frame", "audio", "asr", "ocr", "probe", "timeline", "contract", "human_review"]},
        "method": {"enum": ["deterministic_measurement", "automatic_model_comparison", "human_review"]},
        "source_ref": {"$ref": "#/$defs/reference"},
        "target_ref": {"$ref": "#/$defs/reference"},
        "observation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  }
}
