{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/universal-source-fidelity/provider_attempt.schema.json",
  "title": "Ephemeral provider attempt",
  "type": "object",
  "required": [
    "attempt_id",
    "operation",
    "request_sha256",
    "status",
    "segment_id",
    "segment_plan_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "attempt_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["CreateAsset", "CreateVideo"]},
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PREPARED",
        "SUBMITTING",
        "RUNNING",
        "AMBIGUOUS",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "segment_id": {
      "anyOf": [{"type": "string"}, {"type": "null"}]
    },
    "segment_plan_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "provider_task_id": {
      "anyOf": [{"type": "string"}, {"type": "null"}]
    },
    "response_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    }
  }
}
