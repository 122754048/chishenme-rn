# RunningHub workflow key: storyboard, ASR, TTS, and lip-sync.
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_UPLOAD_URL=https://www.runninghub.ai/openapi/v2/media/upload/binary
RUNNINGHUB_QUERY_URL=https://www.runninghub.ai/openapi/v2/query

# RunningHub Standard Model: Seedance video and @Audio1 song references.
RUNNINGHUB_SEEDANCE_API_KEY=
SEEDANCE_API_PROVIDER=runninghub_standard
RUNNINGHUB_SEEDANCE_CREATE_URL=https://www.runninghub.cn/openapi/v2/bytedance/seedance-2.0-fast-token/multimodal-video
RUNNINGHUB_SEEDANCE_QUERY_URL=https://www.runninghub.cn/openapi/v2/query
RUNNINGHUB_SEEDANCE_UPLOAD_URL=https://www.runninghub.cn/openapi/v2/media/upload/binary

USFR_CONSOLE_DATA_ROOT=./data
USFR_CONSOLE_PORT=8765
# Runtime inputs, analysis, cache, and task state expire after this window.
USFR_CONSOLE_TEMP_TTL_SECONDS=86400
# Optional: standard durable USFR commercial batch API.
USFR_COMMERCIAL_BATCH_API_URL=
